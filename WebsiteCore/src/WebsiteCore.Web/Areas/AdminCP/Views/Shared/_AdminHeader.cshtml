@{
    var u = ViewBag.CurrentUser as WebsiteCore.Business.ViewModels.LoggedInUser;
    var siteName = (ViewBag.Site as WebsiteCore.Data.Entities.Site)?.NameCompanyL ?? "TRUNG TÂM Y TẾ PHƯỜNG KINH MÔN";
}
<div class="navbar-container" id="navbar-container">
    <button type="button" class="navbar-toggle menu-toggler pull-left" id="menu-toggler">
        <span class="sr-only">Toggle sidebar</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
    </button>

    <div class="navbar-header pull-left">
        <a href="/AdminCP/Default" class="navbar-brand">
            <img src="/assets/client/images/logo.png" alt="logo" style="height:28px; vertical-align:middle; margin-right:8px;" />
            <small style="color:white;">@siteName.ToUpper()</small>
        </a>
    </div>

    <div class="navbar-buttons navbar-header pull-right" role="navigation">
        <ul class="nav ace-nav">
            <li class="km-nav-item">
                <a href="/" target="_blank" title="Xem website">
                    <i class="ace-icon fa fa-external-link"></i>
                </a>
            </li>
            <li class="km-nav-item">
                <a data-toggle="dropdown" href="#" class="dropdown-toggle">
                    <img class="nav-user-photo" src="/assets/client/images/logo.png" alt="@u?.FullName" />
                    <span class="user-info">
                        <small>Xin chào,</small>
                        <strong>@(u?.FullName ?? u?.UserName)</strong>
                    </span>
                    <i class="ace-icon fa fa-caret-down"></i>
                </a>

                <ul class="user-menu dropdown-menu-right dropdown-menu dropdown-yellow dropdown-caret dropdown-close">
                    <li>
                        <a href="/staff-profile">
                            <i class="ace-icon fa fa-user"></i> Hồ sơ cán bộ
                        </a>
                    </li>
                    <li>
                        <a href="/doi-mat-khau">
                            <i class="ace-icon fa fa-key"></i> Đổi mật khẩu
                        </a>
                    </li>
                    <li class="divider"></li>
                    <li>
                        <a href="/AdminCP/Login/Logout">
                            <i class="ace-icon fa fa-power-off"></i> Đăng xuất
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </div>
</div>
