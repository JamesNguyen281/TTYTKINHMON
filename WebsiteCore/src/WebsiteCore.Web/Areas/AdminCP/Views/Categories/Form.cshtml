@model WebsiteCore.Data.Entities.Category
@using WebsiteCore.Business
@using WebsiteCore.Data.Entities
@{
    var isEdit = Model.Id != Guid.Empty;
    var types = new[] {
        Constants.TypeMainMenu, Constants.TypeBlockFooter, Constants.TypeBlockSlide,
        Constants.TypeBlockSlideText, Constants.TypeOutstandingService
    };
    var parents = ViewBag.ParentCategories as List<Category> ?? new List<Category>();
}

<h2 style="color:#0a3d62;"><i class="fa fa-list"></i> @ViewData["Title"]</h2>
<a href="/AdminCP/Categories" class="btn btn-default" style="margin-bottom:12px;">← Quay lại</a>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-6 form-group">
            <label>Tên (vi) <span class="text-danger">*</span></label>
            <input asp-for="NameL" class="form-control" required />
        </div>
        <div class="col-md-6 form-group">
            <label>Tên (en)</label>
            <input asp-for="NameE" class="form-control" />
        </div>
        <div class="col-md-3 form-group">
            <label>Loại danh mục</label>
            <select asp-for="Type" class="form-control">
                @foreach (var t in types) { <option value="@t" selected="@(t == Model.Type)">@t</option> }
            </select>
        </div>
        <div class="col-md-3 form-group">
            <label>Danh mục cha</label>
            <select asp-for="ParentId" class="form-control">
                <option value="">— Không có (cấp 1) —</option>
                @foreach (var p in parents)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.ParentId)">@p.NameL <small>(@p.Type)</small></option>
                }
            </select>
        </div>
        <div class="col-md-3 form-group">
            <label>Alias (vi)</label>
            <input asp-for="AliasL" class="form-control" placeholder="tin-tuc, dich-vu..." />
        </div>
        <div class="col-md-3 form-group">
            <label>Link</label>
            <input asp-for="Link" class="form-control" placeholder="chuyen-muc/tin-tuc" />
        </div>
        <div class="col-md-12 form-group">
            <label>Mô tả (vi)</label>
            <textarea asp-for="DescriptionL" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-md-6 form-group">
            <label>Image / Icon (vd: <code>fa:fa fa-stethoscope</code>)</label>
            <input asp-for="ImagePath" class="form-control" />
        </div>
        <div class="col-md-3 form-group">
            <label>Thứ tự</label>
            <input asp-for="Ord" class="form-control" type="number" />
        </div>
        <div class="col-md-3 form-group">
            <label>Active</label>
            <select asp-for="ActiveFlag" class="form-control">
                <option value="1" selected="@(Model.ActiveFlag == 1)">Active</option>
                <option value="0" selected="@(Model.ActiveFlag == 0)">Inactive</option>
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu</button>
</form>
