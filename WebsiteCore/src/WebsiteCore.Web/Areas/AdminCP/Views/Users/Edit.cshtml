@model WebsiteCore.Data.Entities.User
@{ ViewData["Title"] = "Sửa user: " + Model.UserName; }

<h2 style="color:#0a3d62;"><i class="fa fa-pencil"></i> Sửa user: <code>@Model.UserName</code></h2>

<form method="post" action="/AdminCP/Users/Edit/@Model.Id">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="form-group">
        <label>Họ tên</label>
        <input name="FullName" class="form-control" value="@Model.FullName" />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input name="Email" type="email" class="form-control" value="@Model.Email" />
    </div>
    <div class="form-group">
        <label>SĐT</label>
        <input name="Phone" class="form-control" value="@Model.Phone" />
    </div>
    <div class="form-group">
        <label>Nhóm</label>
        <select name="GroupId" class="form-control">
            <option value="ADMIN" selected="@(Model.GroupId == "ADMIN")">ADMIN</option>
            <option value="DOCTOR" selected="@(Model.GroupId == "DOCTOR")">DOCTOR</option>
            <option value="RECEPTION" selected="@(Model.GroupId == "RECEPTION")">RECEPTION</option>
            <option value="MEMBER" selected="@(Model.GroupId == "MEMBER")">MEMBER</option>
            <option value="POSTER" selected="@(Model.GroupId == "POSTER")">POSTER</option>
        </select>
    </div>
    <div class="form-group">
        <label>Active</label>
        <select name="ActiveFlag" class="form-control">
            <option value="1" selected="@(Model.ActiveFlag == 1)">1 - Active</option>
            <option value="0" selected="@(Model.ActiveFlag == 0)">0 - Inactive</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu</button>
    <a href="/AdminCP/Users" class="btn btn-default">Huỷ</a>
</form>
