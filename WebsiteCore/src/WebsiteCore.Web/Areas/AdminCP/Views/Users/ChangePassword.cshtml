@model WebsiteCore.Data.Entities.User
@{ ViewData["Title"] = "Đổi mật khẩu: " + Model.UserName; }

<h2 class="admin-page-title"><i class="fa fa-key"></i> Đặt lại mật khẩu — <code style="font-size:18px;">@Model.UserName</code></h2>

<div class="admin-card" style="max-width:520px;">
    <div class="admin-card-body">
        <form method="post" action="/AdminCP/Users/ChangePassword/@Model.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-group">
                <label>Mật khẩu mới <span class="text-danger">*</span></label>
                <input name="newPassword" type="password" class="form-control" required
                       minlength="6" maxlength="100" autocomplete="new-password" />
                <small class="text-muted">
                    <i class="fa fa-info-circle"></i>
                    Khuyến nghị: ≥8 ký tự, có chữ HOA, chữ thường, số và ký tự đặc biệt.
                    Nếu đặt mặc định <code>123456</code>, user sẽ bị buộc đổi khi đăng nhập (trừ ADMIN).
                </small>
            </div>
            <div class="form-group">
                <label>Xác nhận mật khẩu <span class="text-danger">*</span></label>
                <input name="confirmPassword" type="password" class="form-control" required minlength="6" maxlength="100" autocomplete="new-password" />
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu mật khẩu</button>
            <a href="/AdminCP/Users" class="btn btn-default">Huỷ</a>
        </form>
    </div>
</div>
