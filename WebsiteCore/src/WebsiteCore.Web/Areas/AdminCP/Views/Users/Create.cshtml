@model WebsiteCore.Data.Entities.User
@{ ViewData["Title"] = "Thêm người dùng"; }

<h2 class="admin-page-title"><i class="fa fa-user-plus"></i> Thêm người dùng</h2>

<div class="admin-card">
    <div class="admin-card-body">
        <form method="post" action="/AdminCP/Users/Create">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Username <span class="text-danger">*</span></label>
                        <input name="UserName" class="form-control" required minlength="4" maxlength="50"
                               pattern="[a-z0-9_\.]+" title="4-50 ký tự, chỉ chữ thường/số/_/."
                               placeholder="vd: bsnam" autocomplete="off" />
                        <small class="text-muted"><i class="fa fa-info-circle"></i> 4-50 ký tự, chỉ chữ thường + số + . + _</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Mật khẩu <span class="text-danger">*</span></label>
                        <input name="Password" type="password" class="form-control" required
                               minlength="6" maxlength="100"
                               value="123456"
                               title="Mặc định '123456' — user sẽ buộc đổi khi đăng nhập lần đầu" />
                        <small class="text-muted">
                            <i class="fa fa-shield"></i>
                            Mặc định <code>123456</code>. Khi user đăng nhập lần đầu sẽ <strong>bắt buộc</strong> đổi mật khẩu mới.
                        </small>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Họ tên</label>
                <input name="FullName" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Email</label>
                        <input name="Email" type="email" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>SĐT</label>
                        <input name="Phone" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Nhóm</label>
                        <select name="GroupId" class="form-control">
                            <option value="MEMBER">MEMBER (Bệnh nhân)</option>
                            <option value="DOCTOR">DOCTOR (Bác sĩ)</option>
                            <option value="RECEPTION">RECEPTION (Lễ tân)</option>
                            <option value="POSTER">POSTER (Đăng tin)</option>
                            <option value="ADMIN">ADMIN (Quản trị)</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Trạng thái</label>
                        <select name="ActiveFlag" class="form-control">
                            <option value="1">1 - Active</option>
                            <option value="0">0 - Khoá</option>
                        </select>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu</button>
            <a href="/AdminCP/Users" class="btn btn-default">Huỷ</a>
        </form>
    </div>
</div>
