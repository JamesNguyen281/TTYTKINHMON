@*
    Banner thông báo chạy ngang — đồng bộ giữa public site / portal / AdminCP.
    Nội dung đọc từ wwwroot/assets/admin/notification/notification.txt (rỗng = ẩn banner).
    Admin bật/tắt + chỉnh nội dung tại /AdminCP/Default (form Turnon).
*@
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
@{
    string notiText = "";
    try
    {
        var path = System.IO.Path.Combine(HostEnv.WebRootPath, "assets", "admin", "notification", "notification.txt");
        if (System.IO.File.Exists(path))
        {
            notiText = (await System.IO.File.ReadAllTextAsync(path)).Trim();
        }
    }
    catch { /* fail-soft: không hiển thị banner nếu lỗi đọc file */ }
}
@if (!string.IsNullOrWhiteSpace(notiText))
{
    <div class="km-noti-banner" role="status" aria-live="polite">
        <div class="km-noti-icon"><i class="fa fa-bullhorn"></i></div>
        <div class="km-noti-track">
            <div class="km-noti-content">
                <span>@notiText</span>
                <span class="km-noti-sep">●</span>
                <span>@notiText</span>
                <span class="km-noti-sep">●</span>
            </div>
        </div>
    </div>
    <style>
        .km-noti-banner {
            display: flex; align-items: center;
            width: 100%; clear: both; float: left;
            background: linear-gradient(90deg, #e3eaf3 0%, #f4f7fb 50%, #e3eaf3 100%);
            border-top: 1px solid #cad6e3; border-bottom: 1px solid #cad6e3;
            color: #0a3d62; font-size: 14px; font-weight: 500;
            overflow: hidden; height: 36px; position: relative;
            z-index: 5;
        }
        .km-noti-banner .km-noti-icon {
            flex: 0 0 auto; padding: 0 14px; height: 100%;
            display: flex; align-items: center;
            background: #0a3d62; color: white; font-size: 15px;
        }
        .km-noti-banner .km-noti-track {
            flex: 1 1 auto; overflow: hidden; height: 100%;
            display: flex; align-items: center; padding-left: 14px;
        }
        .km-noti-banner .km-noti-content {
            display: inline-flex; align-items: center; gap: 24px;
            white-space: nowrap;
            animation: km-noti-scroll 35s linear infinite;
            will-change: transform;
        }
        .km-noti-banner .km-noti-content:hover { animation-play-state: paused; }
        .km-noti-banner .km-noti-sep { color: #c0392b; font-size: 10px; }
        @@keyframes km-noti-scroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        @@media (max-width: 768px) {
            .km-noti-banner { font-size: 13px; height: 32px; }
            .km-noti-banner .km-noti-icon { padding: 0 10px; font-size: 13px; }
            .km-noti-banner .km-noti-content { animation-duration: 28s; }
        }
    </style>
}
