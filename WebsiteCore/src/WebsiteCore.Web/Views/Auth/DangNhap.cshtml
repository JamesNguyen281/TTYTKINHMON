@model WebsiteCore.Business.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }

<section class="full-section" style="padding: 40px 0; background: #f5f7fa; min-height: 70vh;">
    <div class="container">
        <div class="row">
            <div class="col-md-5 col-md-offset-1 col-sm-7 col-sm-offset-2 col-xs-12">
                <div style="background: #fff; padding: 32px 28px; border-radius: 6px; box-shadow: 0 2px 12px rgba(10,61,98,0.08);">
                    <h1 style="font-size: 24px; color: #0a3d62; margin-top: 0; text-align: center;">
                        <i class="fa fa-sign-in"></i> Đăng nhập
                    </h1>
                    <p class="text-muted text-center" style="font-size: 13px;">
                        Đăng nhập để đặt lịch khám, xem lịch hẹn và lịch sử khám bệnh của bạn.
                    </p>
                    <hr style="margin: 16px 0;" />

                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"
                         style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">
                        <i class="fa fa-exclamation-circle"></i>
                    </div>

                    <form asp-action="DangNhap" method="post" autocomplete="on">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="form-group">
                            <label asp-for="UserName"><strong>Tên đăng nhập</strong> <span style="color: #c0392b;">*</span></label>
                            <input asp-for="UserName" class="form-control" required minlength="3" maxlength="50"
                                   autofocus autocomplete="username" placeholder="Nhập tên đăng nhập" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Password"><strong>Mật khẩu</strong> <span style="color: #c0392b;">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" required minlength="6" maxlength="100"
                                   autocomplete="current-password" placeholder="Nhập mật khẩu" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 12px;">
                            <i class="fa fa-sign-in"></i> Đăng nhập
                        </button>
                    </form>

                    <div style="margin-top: 18px; text-align: center; font-size: 13px;">
                        <p style="margin: 0 0 8px;">Chưa có tài khoản? <a href="/dang-ky" style="color: #c0392b; font-weight: 600;">Đăng ký bệnh nhân</a></p>
                        <p style="margin: 0;"><a href="/" style="color: #888;"><i class="fa fa-home"></i> Về trang chủ</a></p>
                    </div>
                    <div style="margin-top: 18px; padding: 10px 12px; background: #f4f6f8; border-left: 3px solid #0a3d62; font-size: 12px; color: #555;">
                        <i class="fa fa-info-circle"></i>
                        Trang này dành cho <strong>bệnh nhân</strong>.
                        Bạn là cán bộ y tế?
                        <a href="/AdminCP/Login" style="color: #0a3d62; font-weight: 600;">Đăng nhập tại Cổng quản trị →</a>
                    </div>
                </div>
            </div>
            <div class="col-md-5 hidden-sm hidden-xs">
                <div style="padding: 32px;">
                    <h2 style="color: #0a3d62; font-size: 20px;">Lợi ích khi có tài khoản</h2>
                    <ul style="color: #555; line-height: 1.9; padding-left: 18px;">
                        <li>Đặt lịch khám online nhanh chóng — không phải nhập lại thông tin</li>
                        <li>Theo dõi trạng thái lịch hẹn (chờ duyệt / đã xác nhận / đã khám)</li>
                        <li>Xem lại <strong>lịch sử khám bệnh</strong> đầy đủ tại Trung tâm</li>
                        <li>Xem hồ sơ y tế và đơn thuốc của bạn</li>
                        <li>Đặt câu hỏi với bác sĩ và xem trả lời</li>
                    </ul>
                    <div class="alert alert-info" style="margin-top: 16px; font-size: 13px;">
                        <i class="fa fa-shield"></i>
                        Mật khẩu của bạn được mã hóa PBKDF2 và không được lưu trực tiếp. Tài khoản tạm khóa 15 phút sau 5 lần nhập sai.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
