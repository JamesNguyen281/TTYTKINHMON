@model WebsiteCore.Business.ViewModels.AppointmentRow
@using WebsiteCore.Data.Entities
@using WebsiteCore.Business
@using WebsiteCore.Business.ViewModels
@{
    ViewData["Title"] = "Chi tiết lịch hẹn";
    var availabilities = ViewBag.Availabilities as List<DoctorAvailabilityVm> ?? new();
    var deptOverview   = ViewBag.DeptOverview as DepartmentSlotOverviewVm;
    var fallbackDocs   = ViewBag.FallbackDoctors as List<Doctor> ?? new();
    var clinicRooms    = ViewBag.ClinicRooms as List<ClinicRoom> ?? new();
    int allDocCount    = (int)(ViewBag.AllDoctorsCount ?? 0);

    // Chỉ cho phân BS khi pending hoặc rescheduled (sau confirm BS-quota đã trừ).
    bool canAssign = Model.Status == "pending" || Model.Status == "rescheduled";
    // Phân phòng khám được phép cả khi đã confirmed — lễ tân route lại nếu BN nhầm phòng.
    bool canAssignRoom = Model.Status != "completed" && Model.Status != "cancelled" && Model.Status != "rejected";
    var assignedAvail = Model.DoctorId.HasValue
        ? availabilities.FirstOrDefault(x => x.DoctorId == Model.DoctorId.Value)
        : null;
    var assignedName = assignedAvail?.DoctorName
        ?? fallbackDocs.FirstOrDefault(d => d.Id == Model.DoctorId)?.NameL;
    var assignedRoom = Model.ClinicRoomId.HasValue
        ? clinicRooms.FirstOrDefault(r => r.Id == Model.ClinicRoomId.Value)
        : null;
}

<div class="container" style="padding-top:24px;">
    <h2 style="color:#0a3d62;"><i class="fa fa-clipboard"></i> Chi tiết lịch hẹn</h2>

    <a href="/le-tan/lich-hen?status=@Model.Status" class="btn btn-sm btn-default" style="margin-bottom:12px;">← Hàng đợi</a>

    <div class="panel panel-default">
        <div class="panel-heading"><strong>Thông tin</strong></div>
        <div class="panel-body">
            <dl class="dl-horizontal">
                <dt>Bệnh nhân</dt> <dd><strong>@Model.PatientName</strong></dd>
                <dt>SĐT</dt> <dd><a href="tel:@Model.PatientPhone">@Model.PatientPhone</a></dd>
                <dt>Email</dt> <dd>@(Model.PatientEmail ?? "—")</dd>
                <dt>Chuyên khoa</dt> <dd>@Model.DepartmentName</dd>
                <dt>Ngày/buổi</dt> <dd>
                    @(Model.AppointmentDate?.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN")) ?? "—")
                    · @(Model.Session == "morning" ? "Buổi sáng" : "Buổi chiều")
                </dd>
                <dt>Lý do</dt> <dd>@Model.Reason</dd>
                <dt>Mã khám</dt> <dd>
                    @if (!string.IsNullOrEmpty(Model.BookingCode))
                    { <code style="font-size:18px;">@Model.BookingCode</code> }
                    else { <em class="text-muted">Chưa sinh (chỉ tạo khi duyệt confirmed)</em> }
                </dd>
                <dt>Trạng thái</dt> <dd>
                    <span class="label label-@(Model.Status == "confirmed" ? "success" : Model.Status == "pending" ? "warning" : "default")">@Constants.ApptStatusLabel(Model.Status)</span>
                    @if (Model.CheckedIn) { <span class="label label-info">Đã check-in</span> }
                </dd>
                <dt>Phòng khám</dt> <dd>
                    @if (assignedRoom != null)
                    {
                        <strong style="color:#0a3d62;"><i class="fa fa-door-open"></i> @assignedRoom.RoomCode — @assignedRoom.RoomName</strong>
                        @if (!string.IsNullOrEmpty(assignedRoom.Floor)) { <span class="text-muted"> · @assignedRoom.Floor</span> }
                        @if (!string.IsNullOrEmpty(assignedRoom.SpecialtyL)) { <br /><small class="text-muted">@assignedRoom.SpecialtyL</small> }
                    }
                    else
                    {
                        <em class="text-muted">Chưa phân phòng — lễ tân cần route BN vào phòng khám phù hợp theo triệu chứng</em>
                    }
                </dd>
                <dt>Bác sĩ phụ trách</dt> <dd>
                    @if (Model.DoctorId.HasValue)
                    {
                        <strong style="color:#0a3d62;"><i class="fa fa-user-md"></i> @(assignedName ?? "BS đã phân (ngoài khoa)")</strong>
                    }
                    else
                    {
                        <em class="text-muted">Chưa phân — bác sĩ chưa thấy lịch này trong danh sách "Bệnh nhân hôm nay"</em>
                    }
                </dd>
                @if (!string.IsNullOrEmpty(Model.StaffNote))
                {
                    <dt>Ghi chú lễ tân</dt> <dd>@Model.StaffNote</dd>
                }
            </dl>
        </div>
    </div>

    @* P2.A: Panel phân phòng khám — luôn hiện khi appointment chưa đóng *@
    @if (canAssignRoom)
    {
        <div class="panel panel-warning" id="panel-assign-room">
            <div class="panel-heading">
                <strong><i class="fa fa-door-open"></i> Phân phòng khám</strong>
                <small style="font-weight:normal; opacity:.85; margin-left:8px;">— route BN vào phòng phù hợp theo triệu chứng (mọi BN khám thường đều phải qua Khoa Khám bệnh)</small>
            </div>
            <div class="panel-body">
                @if (!clinicRooms.Any())
                {
                    <div class="alert alert-warning" style="margin:0;">
                        <i class="fa fa-warning"></i> Hệ thống chưa có phòng khám nào. Quản trị viên cần seed ClinicRoom trước khi tiếp nhận BN.
                    </div>
                }
                else
                {
                    <form asp-action="AssignRoom" method="post" id="frm-assign-room">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="km-room-pick-grid">
                            @foreach (var r in clinicRooms.OrderBy(x => x.Ord ?? 999).ThenBy(x => x.RoomCode))
                            {
                                bool isPicked = Model.ClinicRoomId == r.Id;
                                <label class="km-room-card @(isPicked ? "is-picked" : "")">
                                    <input type="radio" name="clinicRoomId" value="@r.Id" checked="@isPicked" />
                                    <div class="km-room-body">
                                        <div class="km-room-code">@r.RoomCode</div>
                                        <div class="km-room-name">@r.RoomName</div>
                                        @if (!string.IsNullOrEmpty(r.SpecialtyL))
                                        {
                                            <div class="km-room-specialty"><i class="fa fa-stethoscope"></i> @r.SpecialtyL</div>
                                        }
                                        @if (!string.IsNullOrEmpty(r.Floor))
                                        {
                                            <div class="km-room-floor"><i class="fa fa-building"></i> @r.Floor</div>
                                        }
                                        @if (!string.IsNullOrEmpty(r.CommonSymptoms))
                                        {
                                            <div class="km-room-symptoms">
                                                <small><strong>Triệu chứng phổ biến:</strong> @r.CommonSymptoms</small>
                                            </div>
                                        }
                                    </div>
                                </label>
                            }
                            <label class="km-room-card km-room-skip">
                                <input type="radio" name="clinicRoomId" value="" checked="@(!Model.ClinicRoomId.HasValue)" />
                                <div class="km-room-body" style="text-align:center;">
                                    <div style="font-size:24px; color:#6c757d;"><i class="fa fa-ban"></i></div>
                                    <div><strong>Chưa phân</strong></div>
                                </div>
                            </label>
                        </div>
                        <div style="margin-top:14px; display:flex; gap:8px; flex-wrap:wrap;">
                            <button type="submit" class="btn btn-warning"><i class="fa fa-save"></i> Lưu phân phòng</button>
                            <small class="text-muted" style="align-self:center;">@clinicRooms.Count phòng khám đang hoạt động</small>
                        </div>
                    </form>
                }
            </div>
        </div>
        <style>
            .km-room-pick-grid {
                display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
                gap: 12px;
            }
            .km-room-card {
                display: block; padding: 10px 12px; cursor: pointer;
                border: 2px solid #f0ad4e; border-radius: 8px; background: #fffaf3;
                font-weight: normal; margin: 0; transition: all .15s;
            }
            .km-room-card:hover { border-color: #ec971f; background: #fdf5e6; }
            .km-room-card.is-picked { border-color: #d68610; background: #fce8c8; box-shadow: 0 2px 6px rgba(214,134,16,.20); }
            .km-room-card input[type=radio] { margin-right: 6px; }
            .km-room-code { font-size: 11px; font-weight: 700; color: #d68610; letter-spacing: 1px; }
            .km-room-name { font-weight: 700; color: #5d4516; font-size: 14px; margin-top: 2px; }
            .km-room-specialty { font-size: 12px; color: #7a5b1f; margin-top: 4px; font-style: italic; }
            .km-room-floor { font-size: 11px; color: #8a6c2f; margin-top: 2px; }
            .km-room-symptoms { font-size: 11px; color: #5d4516; margin-top: 4px; line-height: 1.3; }
            .km-room-skip { background: #f8f9fa; border-color: #ced4da; }
        </style>
    }

    @if (canAssign)
    {
        <div class="panel panel-info" id="panel-assign-doctor">
            <div class="panel-heading"><strong><i class="fa fa-user-md"></i> Phân bác sĩ phụ trách</strong>
                <small style="font-weight:normal; opacity:.85; margin-left:8px;">— hệ thống đã filter chỉ BS có lịch trực + còn slot, sort BS rảnh nhất lên đầu</small>
            </div>
            <div class="panel-body">
                @if ((bool?)ViewBag.IsFilteredByRoom == true && assignedRoom != null)
                {
                    <div class="alert" style="background:#e8f5e9; border:1px solid #c8e6c9; color:#2e7d32; margin-bottom:16px;">
                        <i class="fa fa-filter"></i>
                        <strong>Đang lọc theo phòng <span style="background:#2e7d32; color:white; padding:2px 8px; border-radius:10px;">@assignedRoom.RoomCode @assignedRoom.RoomName</span></strong>
                        — chỉ hiển thị BS có lịch trực phòng này. Đổi phòng ở trên để xem BS khác.
                    </div>
                }
                else if ((bool?)ViewBag.RoomFilteredEmpty == true && assignedRoom != null)
                {
                    <div class="alert alert-warning" style="margin-bottom:16px;">
                        <i class="fa fa-warning"></i>
                        <strong>Phòng @assignedRoom.RoomCode @assignedRoom.RoomName chưa có BS được phân lịch trực</strong> cho ngày + ca này.
                        Hệ thống chuyển sang hiển thị toàn bộ BS của khoa <strong>@Model.DepartmentName</strong> để bạn chọn thủ công.
                    </div>
                }
                @if (deptOverview != null)
                {
                    int deptPercent = deptOverview.DeptMaxSlots > 0
                        ? Math.Min(100, deptOverview.DeptBookedSlots * 100 / deptOverview.DeptMaxSlots) : 0;
                    string deptBarColor = deptPercent >= 90 ? "#d9534f" : deptPercent >= 70 ? "#f0ad4e" : "#5cb85c";
                    <div class="alert" style="background:#f0f7fb; border:1px solid #c8d8e3; margin-bottom:16px;">
                        <strong><i class="fa fa-hospital-o"></i> Quota khoa @deptOverview.DepartmentName</strong>
                        — buổi @(deptOverview.Session == "morning" ? "sáng" : "chiều") ngày @deptOverview.Date.ToString("dd/MM/yyyy"):
                        <strong>@deptOverview.DeptBookedSlots / @deptOverview.DeptMaxSlots</strong>
                        <span class="text-muted">(còn @deptOverview.DeptRemaining)</span>
                        <div style="height:8px; background:#e1e8ed; border-radius:4px; margin-top:6px; overflow:hidden;">
                            <div style="height:100%; width:@(deptPercent)%; background:@deptBarColor;"></div>
                        </div>
                    </div>
                }

                @if (!availabilities.Any() && !fallbackDocs.Any())
                {
                    <div class="alert alert-warning" style="margin:0;">
                        <i class="fa fa-warning"></i>
                        Khoa <strong>@Model.DepartmentName</strong> chưa có bác sĩ nào.
                        Vui lòng nhờ Quản trị viên bổ sung bác sĩ cho khoa này trước.
                    </div>
                }
                else if (!availabilities.Any() && fallbackDocs.Any())
                {
                    <div class="alert alert-warning">
                        <i class="fa fa-warning"></i>
                        <strong>Không có bác sĩ nào trực vào ngày + ca này.</strong> Có thể do hệ thống chưa sinh lịch trực tháng này.
                        Phương án dự phòng: chọn từ danh sách BS cùng khoa bên dưới (không kiểm tra slot — admin tự chịu trách nhiệm phân bổ).
                    </div>
                    <form asp-action="AssignDoctor" method="post" class="form-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="doctorId" class="form-control" style="min-width:280px;">
                            <option value="">— Bỏ phân —</option>
                            @foreach (var d in fallbackDocs)
                            {
                                <option value="@d.Id" selected="@(d.Id == Model.DoctorId)">@d.NameL @(string.IsNullOrEmpty(d.SpeciallyL) ? "" : " — " + d.SpeciallyL)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-warning"><i class="fa fa-save"></i> Lưu phân công (dự phòng)</button>
                    </form>
                }
                else
                {
                    <form asp-action="AssignDoctor" method="post" id="frm-assign">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="km-doctor-pick-grid">
                            @foreach (var (a, idx) in availabilities.Select((v, i) => (v, i)))
                            {
                                bool isPicked   = Model.DoctorId == a.DoctorId;
                                bool isFirstAvailable = idx == 0 && !Model.DoctorId.HasValue && a.IsAvailable;
                                string fillColor = a.FillPercent >= 90 ? "#d9534f"
                                                 : a.FillPercent >= 70 ? "#f0ad4e" : "#5cb85c";
                                <label class="km-doctor-card @(a.IsAvailable ? "" : "is-full") @(isPicked ? "is-picked" : "")"
                                       data-remaining="@a.RemainingSlots">
                                    <input type="radio" name="doctorId" value="@a.DoctorId"
                                           checked="@(isPicked || isFirstAvailable)"
                                           disabled="@(!a.IsAvailable)" />
                                    <div class="km-card-avatar">
                                        @if (!string.IsNullOrEmpty(a.ImagePath))
                                        {
                                            <img src="/@a.ImagePath.TrimStart('/')" alt="@a.DoctorName"
                                                 onerror="this.onerror=null;this.src='/assets/admin/images/user_none.jpg';" />
                                        }
                                        else
                                        {
                                            <img src="/assets/admin/images/user_none.jpg" alt="" />
                                        }
                                    </div>
                                    <div class="km-card-body">
                                        <div class="km-card-name">@a.DoctorName</div>
                                        @if (!string.IsNullOrEmpty(a.Position))
                                        {
                                            <div class="km-card-position">@a.Position</div>
                                        }
                                        @if (!string.IsNullOrEmpty(a.Specialty))
                                        {
                                            <div class="km-card-specialty"><i class="fa fa-stethoscope"></i> @a.Specialty</div>
                                        }
                                        <div class="km-card-room">
                                            @if (!string.IsNullOrEmpty(a.Room)) { <span><i class="fa fa-door-open"></i> Phòng @a.Room</span> }
                                            @if (idx == 0 && a.IsAvailable) { <span class="km-tag-recommend">Đề xuất (rảnh nhất)</span> }
                                        </div>
                                        <div class="km-card-slot">
                                            <div class="km-slot-text">
                                                <strong>@a.BookedSlots / @a.MaxSlots</strong> ca
                                                @if (a.IsAvailable) { <span class="text-muted">— còn @a.RemainingSlots</span> }
                                                else { <span class="text-danger"><i class="fa fa-ban"></i> hết suất</span> }
                                            </div>
                                            <div class="km-slot-bar">
                                                <div class="km-slot-fill" style="width:@(a.FillPercent)%; background:@fillColor;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </label>
                            }
                            <label class="km-doctor-card km-card-skip">
                                <input type="radio" name="doctorId" value="" checked="@(!Model.DoctorId.HasValue && !availabilities.Any(x => x.IsAvailable))" />
                                <div class="km-card-body" style="text-align:center;">
                                    <div style="font-size:24px; color:#6c757d;"><i class="fa fa-ban"></i></div>
                                    <div><strong>Chưa phân</strong></div>
                                    <small class="text-muted">Để lễ tân khác phân sau</small>
                                </div>
                            </label>
                        </div>
                        <div style="margin-top:14px; display:flex; gap:8px; flex-wrap:wrap;">
                            <button type="submit" class="btn btn-info"><i class="fa fa-save"></i> Lưu phân công</button>
                            <small class="text-muted" style="align-self:center;">
                                @availabilities.Count(x => x.IsAvailable) BS còn slot / tổng @availabilities.Count BS có lịch trực ngày này
                            </small>
                        </div>
                    </form>
                }
            </div>
        </div>

        <style>
            .km-doctor-pick-grid {
                display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 12px;
            }
            .km-doctor-card {
                display: flex; gap: 12px; padding: 12px; cursor: pointer;
                border: 2px solid #dee2e6; border-radius: 8px; background: #fff;
                font-weight: normal; margin: 0; transition: all .15s;
            }
            .km-doctor-card:hover { border-color: #0a3d62; background: #f8fbfd; }
            .km-doctor-card.is-picked { border-color: #0a3d62; background: #e6f0f7; box-shadow: 0 2px 6px rgba(10,61,98,.15); }
            .km-doctor-card.is-full { opacity: .55; cursor: not-allowed; background: #f8f9fa; }
            .km-doctor-card.is-full:hover { border-color: #dee2e6; background: #f8f9fa; }
            .km-doctor-card input[type=radio] { margin-top: 4px; }
            .km-card-avatar img {
                width: 56px; height: 56px; border-radius: 50%;
                object-fit: cover; border: 2px solid #eef5fb;
            }
            .km-card-body { flex: 1; min-width: 0; }
            .km-card-name { font-weight: 700; color: #0a3d62; font-size: 15px; }
            .km-card-position { font-size: 12px; color: #1d5688; font-weight: 600; margin-top: 2px; }
            .km-card-specialty { font-size: 12px; color: #5a6c7d; margin-top: 4px; font-style: italic; }
            .km-card-room { font-size: 11px; color: #6c757d; margin-top: 4px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
            .km-tag-recommend {
                background: #28a745; color: #fff; padding: 2px 8px;
                border-radius: 10px; font-size: 10px; font-weight: 700;
            }
            .km-card-slot { margin-top: 8px; }
            .km-slot-text { font-size: 12px; }
            .km-slot-bar { height: 6px; background: #e1e8ed; border-radius: 3px; overflow: hidden; margin-top: 4px; }
            .km-slot-fill { height: 100%; transition: width .3s; }
            .km-card-skip { background: #f8f9fa; }
        </style>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> @TempData["Error"]</div>
    }

    @{
        // Whitelist transition cho từng status — đồng bộ với AppointmentService.AllowedTransitions
        var transitions = Model.Status switch
        {
            "pending"     => new[] { ("confirmed", "Xác nhận (sẽ sinh mã khám)"), ("rescheduled","Đề nghị đổi lịch"), ("rejected","Từ chối"), ("cancelled","Huỷ") },
            "confirmed"   => new[] { ("completed","Hoàn tất"), ("cancelled","Huỷ"), ("rescheduled","Đổi lịch") },
            "rescheduled" => new[] { ("confirmed","Xác nhận"), ("rejected","Từ chối"), ("cancelled","Huỷ") },
            _ => Array.Empty<(string, string)>()
        };
    }

    @if (transitions.Length > 0)
    {
        <div class="panel panel-primary">
            <div class="panel-heading"><strong>Cập nhật trạng thái</strong></div>
            <div class="panel-body">
                <form action="/le-tan/cap-nhat-trang-thai" method="post" id="frm-status">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="form-group">
                        <label>Trạng thái mới</label>
                        <select name="newStatus" id="ns" class="form-control" required>
                            @foreach (var (val, lbl) in transitions)
                            {
                                <option value="@val">@lbl</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label id="lblNote">Ghi chú (tuỳ chọn) <small class="text-muted">— bắt buộc khi từ chối</small></label>
                        <textarea name="staffNote" id="staffNote" class="form-control" rows="3"
                                  maxlength="500" placeholder="Lý do từ chối/đổi lịch... (tối đa 500 ký tự)"></textarea>
                        <small class="text-muted">Lý do sẽ hiển thị cho bệnh nhân ở trang "Lịch khám của tôi".</small>
                    </div>
                    <button type="submit" class="btn btn-primary" id="btnSubmit">
                        <i class="fa fa-check"></i> Cập nhật trạng thái
                    </button>
                </form>
                <script>
                  (function(){
                    var ns = document.getElementById('ns');
                    var note = document.getElementById('staffNote');
                    var lbl = document.getElementById('lblNote');
                    function refresh(){
                      var rejected = ns.value === 'rejected';
                      note.required = rejected;
                      lbl.innerHTML = rejected
                        ? 'Lý do từ chối <span class="text-danger">*</span>'
                        : 'Ghi chú (tuỳ chọn) <small class="text-muted">— bắt buộc khi từ chối</small>';
                    }
                    ns.addEventListener('change', refresh);
                    refresh();
                    document.getElementById('frm-status').addEventListener('submit', function(e){
                      if(ns.value === 'rejected' && !note.value.trim()){
                        e.preventDefault();
                        alert('Vui lòng nhập lý do từ chối.');
                        note.focus();
                      }
                    });
                  })();
                </script>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fa fa-info-circle"></i> Lịch ở trạng thái <code>@Constants.ApptStatusLabel(Model.Status)</code> — không thể thay đổi tiếp.
        </div>
    }
</div>
