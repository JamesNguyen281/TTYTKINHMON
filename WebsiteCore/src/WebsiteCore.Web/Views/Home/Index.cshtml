@section Scripts {
    <script>
        // CSVC carousel
        (function () {
            var sec = document.querySelector('.csvc-section'); if (!sec) return;
            var track = sec.querySelector('.csvc-track');
            var pages = sec.querySelectorAll('.csvc-page');
            var dots  = sec.querySelectorAll('.csvc-dot');
            var prev  = sec.querySelector('.csvc-prev');
            var next  = sec.querySelector('.csvc-next');
            if (!track || pages.length === 0) return;
            var i = 0;
            function go(idx) {
                if (idx < 0 || idx >= pages.length) return;
                i = idx;
                track.style.transform = 'translateX(-' + (i * 100) + '%)';
                for (var k = 0; k < dots.length; k++) {
                    if (k === i) dots[k].classList.add('active');
                    else dots[k].classList.remove('active');
                }
                if (prev) prev.disabled = (i === 0);
                if (next) next.disabled = (i === pages.length - 1);
            }
            if (prev) prev.addEventListener('click', function () { go(i - 1); });
            if (next) next.addEventListener('click', function () { go(i + 1); });
            for (var k = 0; k < dots.length; k++) {
                (function (idx) {
                    dots[idx].addEventListener('click', function () { go(idx); });
                })(k);
            }
            go(0);
        })();

        // st5 doctor tabs (vanilla JS — không phụ thuộc owl/bootstrap)
        (function () {
            var nav = document.querySelector('.tab-bs.tab-js');
            if (!nav) return;
            var links = nav.querySelectorAll('a[href^="#"]');
            for (var i = 0; i < links.length; i++) {
                links[i].addEventListener('click', function (e) {
                    e.preventDefault();
                    var target = this.getAttribute('href');
                    var lis = nav.querySelectorAll('li');
                    for (var j = 0; j < lis.length; j++) lis[j].classList.remove('active');
                    this.parentElement.classList.add('active');
                    var panes = document.querySelectorAll('.box-content > .tab-content > div');
                    for (var k = 0; k < panes.length; k++) panes[k].classList.remove('active');
                    var pane = document.querySelector(target);
                    if (pane) pane.classList.add('active');
                });
            }
        })();

        // Center align owl carousel khi count ≤ 4 — owl mặc định float-left, items
        // ít hơn slot → cards bị dồn trái và còn slot trống bên phải.
        (function () {
            function centerSmallCarousel() {
                document.querySelectorAll('.slide-st5').forEach(function (c) {
                    var items = c.querySelectorAll('.owl-item:not(.cloned), .item');
                    var stage = c.querySelector('.owl-stage');
                    if (items.length > 0 && items.length <= 4) {
                        c.classList.add('km-centered');
                        if (stage) {
                            stage.style.transform = 'none';
                            stage.style.width = '100%';
                            stage.style.display = 'flex';
                            stage.style.justifyContent = 'center';
                            stage.style.flexWrap = 'wrap';
                            stage.style.gap = '16px';
                        }
                        // Ẩn nút prev/next khi không cần kéo
                        var nav = c.querySelector('.owl-nav');
                        if (nav) nav.style.display = 'none';
                    }
                });
            }
            // Run sau khi owl init xong (delay để owl-stage render)
            if (window.jQuery) {
                jQuery(window).on('load', function () { setTimeout(centerSmallCarousel, 200); });
                setTimeout(centerSmallCarousel, 800);
            } else {
                window.addEventListener('load', function () { setTimeout(centerSmallCarousel, 400); });
            }
            // Re-apply when tab switches
            document.querySelectorAll('.tab-bs.tab-js a').forEach(function (a) {
                a.addEventListener('click', function () { setTimeout(centerSmallCarousel, 50); });
            });
        })();

        // st4 video tabs (vanilla — không cần bootstrap.js)
        (function () {
            var nav = document.querySelector('.st4-right .nav');
            if (!nav) return;
            var links = nav.querySelectorAll('a[href^="#video"]');
            for (var i = 0; i < links.length; i++) {
                links[i].addEventListener('click', function (e) {
                    e.preventDefault();
                    var target = this.getAttribute('href');
                    var lis = nav.querySelectorAll('li');
                    for (var j = 0; j < lis.length; j++) lis[j].classList.remove('active');
                    this.parentElement.classList.add('active');
                    var panes = document.querySelectorAll('.st4-left .tab-content .tab-pane');
                    for (var k = 0; k < panes.length; k++) {
                        panes[k].classList.remove('in', 'active');
                    }
                    var pane = document.querySelector(target);
                    if (pane) pane.classList.add('in', 'active');
                });
            }
        })();
    </script>
}
