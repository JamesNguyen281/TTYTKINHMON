@using WebsiteCore.Data.Entities
@{
    var locate = (ViewBag.Locate as string) ?? "vi";
    bool isEn  = locate == "en";
    ViewData["Title"] = isEn ? "Home" : "Trang chủ";
    var depts        = ViewBag.Departments         as List<Department> ?? new();
    var outstanding  = ViewBag.OutstandingServices as List<Category>   ?? new();
    var news         = ViewBag.FeaturedNews        as List<News>       ?? new();
    var slideBox     = ViewBag.SlideBox            as List<Category>   ?? new();
    var slideTextBox = ViewBag.SlideTextBox        as List<Category>   ?? new();
    var videos       = ViewBag.Videos              as List<Video>      ?? new();
    var doctorIn     = ViewBag.DoctorIn            as List<Doctor>     ?? new();
    var doctorForeign= ViewBag.DoctorForeign       as List<Doctor>     ?? new();

    string L(string? l, string? e) => isEn ? (string.IsNullOrEmpty(e) ? (l ?? "") : e) : (l ?? "");
    var lblFeaturedNews   = isEn ? "Featured news"        : "Tin tức nổi bật";
    var lblOurDoctors     = isEn ? "Our doctors"          : "Đội ngũ bác sĩ";
    var lblOurServices    = isEn ? "Our services"         : "Dịch vụ tiêu biểu";
    var lblBookAppt       = isEn ? "Book appointment"     : "Đặt lịch khám";
    var lblViewMore       = isEn ? "Read more"            : "Xem thêm";

    // Logo fallback đồng bộ Site.LogoUrl (admin set qua /AdminCP/Sites)
    var siteLogoUrl = (ViewBag.Site as Site)?.LogoUrl;
    if (string.IsNullOrEmpty(siteLogoUrl)) siteLogoUrl = "/assets/client/images/logo-kinhmon.png";
}

@functions {
    string ImgPath(string? p, string fallback)
    {
        if (string.IsNullOrEmpty(p)) return fallback;
        if (p.StartsWith("http://") || p.StartsWith("https://") || p.StartsWith("//")) return p;
        return "/" + p.TrimStart('/');
    }
    bool IsFaIcon(string? p) => !string.IsNullOrEmpty(p) && p.StartsWith("fa:", StringComparison.OrdinalIgnoreCase);
    string FaClass(string p) => p.Substring(3).Trim();
}

<h1 style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;">
    Trung tâm Y tế phường Kinh Môn, TP Hải Phòng — đặt lịch khám, chuyên khoa, đội ngũ bác sĩ
</h1>

@* ============= .st0 — Giới thiệu ngắn + Thống kê ============= *@
@{
    int totalDepts   = depts.Count;
    int totalDoctors = (doctorIn?.Count ?? 0) + (doctorForeign?.Count ?? 0);
    if (totalDoctors == 0) totalDoctors = 30; // fallback nếu chưa có data — Trung tâm có khoảng 30+ BS
    if (totalDepts == 0)   totalDepts   = 8;  // 8 khoa chuyên môn
}
<section class="st0-intro full-section">
    <div class="container">
        <div class="st0-grid">
            <div class="st0-text">
                <h2>Trung tâm Y tế phường Kinh Môn</h2>
                <p class="st0-tagline">Tận tâm chăm sóc — Chuyên nghiệp điều trị</p>
                <p class="st0-desc">
                    Trung tâm Y tế phường Kinh Môn là cơ sở y tế công lập hạng II trực thuộc Sở Y tế thành phố Hải Phòng,
                    phục vụ trên <strong>200.000 lượt bệnh nhân ngoại trú</strong> mỗi năm. Với đội ngũ bác sĩ chuyên môn cao
                    và hệ thống trang thiết bị hiện đại, Trung tâm cung cấp dịch vụ khám chữa bệnh đa khoa toàn diện
                    cho người dân khu vực phường Kinh Môn và các vùng lân cận.
                </p>
                <div class="st0-cta">
                    <a href="/gioi-thieu-trung-tam" class="btn-st0-more">Tìm hiểu thêm</a>
                    <a href="/dat-lich-kham" class="btn-st0-book">Đặt lịch khám ngay</a>
                </div>
            </div>
            <div class="st0-stats">
                <div class="stat-card"><div class="stat-num">25<sup>+</sup></div><div class="stat-lbl">Năm hoạt động</div></div>
                <div class="stat-card"><div class="stat-num">@totalDoctors<sup>+</sup></div><div class="stat-lbl">Bác sĩ chuyên khoa</div></div>
                <div class="stat-card"><div class="stat-num">@totalDepts<sup>+</sup></div><div class="stat-lbl">Khoa chuyên môn</div></div>
                <div class="stat-card"><div class="stat-num">200K<sup>+</sup></div><div class="stat-lbl">Lượt khám/năm</div></div>
            </div>
        </div>
    </div>
</section>
<style>
    .st0-intro { padding: 36px 0 28px; background: linear-gradient(135deg,#f4f9ff 0%,#e8f1fb 100%); border-bottom: 1px solid #d8e6f3; }
    .st0-grid  { display: grid; grid-template-columns: 1.4fr 1fr; gap: 36px; align-items: center; }
    .st0-text h2 { color: #0a3d62; font-size: 26px; font-weight: 700; margin: 0 0 6px; }
    .st0-tagline { color: #1d5688; font-size: 16px; font-weight: 600; margin: 0 0 12px; font-style: italic; }
    .st0-desc { color: #2c3e50; font-size: 14.5px; line-height: 1.7; margin: 0 0 18px; text-align: justify; }
    .st0-desc strong { color: #0a3d62; }
    .st0-cta { display: flex; gap: 12px; flex-wrap: wrap; }
    .st0-cta a { padding: 10px 22px; border-radius: 25px; font-weight: 600; font-size: 14px; text-decoration: none; transition: all 0.25s; }
    .btn-st0-more { background: white; color: #0a3d62; border: 2px solid #0a3d62; }
    .btn-st0-more:hover { background: #0a3d62; color: white; }
    .btn-st0-book { background: linear-gradient(135deg,#0a3d62,#1d5688); color: white; box-shadow: 0 4px 12px rgba(10,61,98,0.25); }
    .btn-st0-book:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(10,61,98,0.35); color: white; }

    .st0-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .stat-card { background: white; padding: 22px 14px; border-radius: 12px; text-align: center; box-shadow: 0 4px 14px rgba(10,61,98,0.10); border-top: 4px solid #0a3d62; transition: transform 0.25s; }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(10,61,98,0.15); }
    .stat-card:nth-child(2) { border-top-color: #43aa8b; }
    .stat-card:nth-child(3) { border-top-color: #f6b73c; }
    .stat-card:nth-child(4) { border-top-color: #e84545; }
    .stat-num { font-size: 32px; font-weight: 800; color: #0a3d62; line-height: 1; margin-bottom: 6px; }
    .stat-num sup { font-size: 18px; color: #43aa8b; margin-left: 2px; }
    .stat-lbl { font-size: 12.5px; color: #5e7790; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; }

    @@media (max-width: 768px) {
        .st0-grid { grid-template-columns: 1fr; gap: 22px; }
        .st0-text h2 { font-size: 22px; }
        .stat-num { font-size: 26px; }
    }
</style>

@* ============= .st7 — Tin tức nổi bật ============= *@
<section class="st7 full-section">
    <div class="container">
        <div class="row">
            <div class="box-heading col-xs-12">
                <div class="box-heading col-xs-12 text-center">
                    <h2 class="title-st3 title-st5"><span>@lblFeaturedNews</span></h2>
                </div>
            </div>
            <div class="box-content full-section">
                <div class="slide-st7">
                    @foreach (var item in news)
                    {
                        var titleX = L(item.TitleL, item.TitleE);
                        var descX  = L(item.DescriptionL, item.DescriptionE);
                        var aliasX = isEn && !string.IsNullOrEmpty(item.AliasE) ? item.AliasE : item.AliasL;
                        <div class="col-5">
                            <div class="item">
                                <div class="img-item">
                                    <a href="/tin-tuc/@aliasX">
                                        <img src="@ImgPath(item.ImagePath, siteLogoUrl)" alt="@titleX" loading="lazy"
                                             onerror="this.onerror=null;this.src='@siteLogoUrl';" />
                                    </a>
                                </div>
                                <div class="text-item">
                                    <h2><a href="/tin-tuc/@aliasX">@titleX</a></h2>
                                    <p>@descX</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

