@* ============= .st3 — Cơ sở vật chất / chuyên khoa grid ============= *@
@if (depts.Any())
{
    <section class="st3 full-section csvc-section">
        <div class="container">
            <div class="row">
                <div class="box-heading col-xs-12">
                    <h2 class="title-st3"><span>CƠ SỞ VẬT CHẤT</span></h2>
                </div>
                <div class="box-content full-section">
                    @{
                        int csvcPerPage = 10;
                        int csvcTotal = depts.Count;
                        int csvcPages = csvcTotal == 0 ? 0 : (int)Math.Ceiling((double)csvcTotal / csvcPerPage);
                    }
                    <div class="csvc-wrap">
                        <button type="button" class="csvc-arrow csvc-prev" aria-label="Trang trước">&#8249;</button>
                        <div class="csvc-viewport">
                            <div class="csvc-track">
                                @for (int p = 0; p < csvcPages; p++)
                                {
                                    <div class="csvc-page">
                                        @for (int idx = p * csvcPerPage; idx < Math.Min(csvcTotal, (p + 1) * csvcPerPage); idx++)
                                        {
                                            var item = depts[idx];
                                            <div class="csvc-item">
                                                <a class="csvc-item-img" title="@item.NameL" href="/@item.Link">
                                                    @if (IsFaIcon(item.ImagePath))
                                                    {
                                                        <i class="@FaClass(item.ImagePath!) csvc-fa" aria-hidden="true"></i>
                                                    }
                                                    else
                                                    {
                                                        <img src="@ImgPath(item.ImagePath, siteLogoUrl)" alt="@item.NameL"
                                                             onerror="this.onerror=null;this.src='@siteLogoUrl';" />
                                                    }
                                                </a>
                                                <h2 class="csvc-item-name">
                                                    <a title="@item.NameL" href="/@item.Link">@item.NameL</a>
                                                </h2>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <button type="button" class="csvc-arrow csvc-next" aria-label="Trang sau">&#8250;</button>
                        @if (csvcPages > 1)
                        {
                            <div class="csvc-dots">
                                @for (int p = 0; p < csvcPages; p++)
                                {
                                    <button type="button" class="csvc-dot @(p == 0 ? "active" : "")" data-page="@p" aria-label="Trang @(p + 1)"></button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

