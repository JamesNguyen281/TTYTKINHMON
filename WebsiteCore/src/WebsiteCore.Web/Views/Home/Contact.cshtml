@using WebsiteCore.Data.Entities
@{
    var site = ViewBag.Site as Site;
    var address  = !string.IsNullOrEmpty(site?.AddressL) ? site.AddressL : "Số 294 đường Trần Hưng Đạo, phường Kinh Môn, Thành phố Hải Phòng";
    var emer     = !string.IsNullOrEmpty(site?.EmergencyNumber) ? site.EmergencyNumber : "02203.822.205";
    var hotline  = !string.IsNullOrEmpty(site?.Hotline) ? site.Hotline : "0964.801.616";
    var emailA   = !string.IsNullOrEmpty(site?.Email) ? site.Email : "ttytkinhmon@haiphong.gov.vn";
    ViewData["Title"] = "Liên hệ";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Liên hệ", null) };
}

<div class="container" style="padding:24px 15px;">
    <div class="row">
        <div class="col-md-5">
            <h2 style="color:#0a3d62; margin-top:0; font-weight:600; font-size:24px;"><i class="fa fa-map-marker"></i> Trung tâm Y tế phường Kinh Môn</h2>
            <p style="color:#495057; line-height:1.7;">@address</p>
            <hr />
            <ul class="list-unstyled" style="line-height:2;">
                <li><i class="fa fa-ambulance text-danger" style="width:24px;"></i> <strong>Cấp cứu 24/7:</strong> <a href="tel:@emer">@emer</a></li>
                <li><i class="fa fa-phone text-success" style="width:24px;"></i> <strong>Đường dây nóng:</strong> <a href="tel:@hotline">@hotline</a></li>
                <li><i class="fa fa-envelope text-primary" style="width:24px;"></i> <strong>Email:</strong> <a href="mailto:@emailA">@emailA</a></li>
                <li><i class="fa fa-clock-o text-warning" style="width:24px;"></i> <strong>Giờ làm việc:</strong> 7:00 — 17:00 các ngày trong tuần</li>
            </ul>
            <iframe src="https://maps.google.com/maps?q=@(Uri.EscapeDataString(address))&output=embed"
                    style="width:100%; height:280px; border:1px solid #e0e6ed; border-radius:6px; margin-top:16px;"
                    loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="col-md-7">
            <h3 style="color:#0a3d62; margin-top:0; font-weight:600; font-size:20px;"><i class="fa fa-envelope-o"></i> Hộp thư góp ý</h3>
            <p class="text-muted">Mọi thắc mắc, góp ý, phản ánh xin gửi qua biểu mẫu — chúng tôi sẽ phản hồi trong vòng 24-48 giờ làm việc.</p>

            @if (TempData["ContactOk"] != null)
            {
                <div class="alert alert-success"><i class="fa fa-check-circle"></i> @TempData["ContactOk"]</div>
            }
            @if (TempData["ContactErr"] != null)
            {
                <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> @TempData["ContactErr"]</div>
            }

            <form method="post" action="/lien-he/gui-gop-y" class="contact-form">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Họ tên <span class="text-danger">*</span></label>
                            <input name="fullName" class="form-control" required maxlength="150" />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            <input name="phone" type="tel" class="form-control" maxlength="20" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input name="email" type="email" class="form-control" maxlength="100" />
                </div>
                <div class="form-group">
                    <label>Chủ đề</label>
                    <input name="subject" class="form-control" maxlength="200" placeholder="Đặt lịch khám / Phản ánh dịch vụ / Góp ý..." />
                </div>
                <div class="form-group">
                    <label>Nội dung <span class="text-danger">*</span></label>
                    <textarea name="content" rows="5" class="form-control" required maxlength="2000"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fa fa-paper-plane"></i> Gửi góp ý
                </button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .contact-form .form-control:focus { border-color: #0a3d62; box-shadow: 0 0 0 2px rgba(10,61,98,0.15); }
        .contact-form label { font-weight: 600; color: #2c3e50; }
        .contact-form .btn-primary { background: #0a3d62; border-color: #0a3d62; padding: 8px 28px; }
        .contact-form .btn-primary:hover { background: #06283d; border-color: #06283d; }
    </style>
}
