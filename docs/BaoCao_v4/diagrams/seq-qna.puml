@startuml seq-qna
' =========================================================================
' Hình 2.16 — Biểu đồ tuần tự nghiệp vụ Hỏi đáp Q&A 
' =========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5
skinparam ParticipantBackgroundColor #FCE4EC
skinparam ParticipantBorderColor #AD1457
skinparam ActorBackgroundColor #FFD27F
skinparam ActorBorderColor #000000

title Biểu đồ tuần tự — Hỏi đáp Q&A

autonumber

actor "Bệnh nhân" as BN
actor "Quản trị"  as QT
actor "Bác sĩ"    as BS
participant "Trình duyệt"      as B
participant "QnaController"    as C
participant "QnaService"       as S
database    "SQL Server"       as DB

BN -> B: Vào /hoi-dap → Đặt câu hỏi mới
B -> C: GET /hoi-dap/dat-cau-hoi

alt Chưa đăng nhập
    C --> B: Redirect /dang-nhap
else Đã đăng nhập
    C --> B: Render form\n(tiêu đề, nội dung, chuyên khoa)
    BN -> B: Nhập + submit
    B -> C: POST /hoi-dap/dat-cau-hoi
    C -> C: Validate CSRF + length cap\n(body ≤ 500)
    C -> S: SubmitQuestionAsync(userId, title, body, deptId)
    S -> DB: INSERT qa_question\n(status=Pending, created_at)
    DB --> S: question_id
    S --> C: question_id
    C --> B: Hiển thị "Đã gửi, chờ duyệt"
end

== Quản trị viên duyệt câu hỏi ==

QT -> B: Vào /AdminCP/Qna
B -> C: GET danh sách câu hỏi pending
C -> DB: SELECT qa_question WHERE status=Pending
DB --> C: List
C --> B: Render bảng duyệt

QT -> B: Approve / Reject 1 câu hỏi
B -> C: POST /AdminCP/Qna/Approve hoặc Reject

alt Approve
    C -> S: ApproveQuestionAsync(questionId)
    S -> DB: UPDATE status = Visible
    S -> DB: INSERT audit_system\n(action=QNA_APPROVED)
else Reject
    C -> S: RejectQuestionAsync(questionId, reason)
    S -> DB: UPDATE status=Rejected, soft_delete=1
    S -> DB: INSERT audit_system\n(action=QNA_REJECTED)
end

== Bác sĩ trả lời ==

BS -> B: Vào /bac-si-portal/qna
B -> C: GET câu hỏi thuộc chuyên khoa,\nstatus=Visible
C -> DB: SELECT qa_question WHERE specialty=?\nAND status=Visible
DB --> C: List
C --> B: Render bảng câu hỏi

BS -> B: Nhập câu trả lời + submit
B -> C: POST /bac-si-portal/qna/answer
C -> S: AnswerQuestionAsync(questionId, answerBody)
S -> DB: UPDATE qa_question\nSET answer=?, answered_at=now
S -> DB: INSERT audit_system\n(action=QNA_ANSWERED)
S --> C: OK
C --> B: Hiển thị "Đã trả lời"

note over BN
    Câu hỏi + trả lời hiển thị
    công khai trên /hoi-dap
end note

@enduml
