@startuml seq-qna
' =========================================================================
' Hình 2.16 — Biểu đồ tuần tự nghiệp vụ Hỏi đáp Q&A
' =========================================================================
skinparam dpi 300
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5
skinparam BoundaryBackgroundColor #FCE4EC
skinparam BoundaryBorderColor #AD1457
skinparam ControlBackgroundColor #FCE4EC
skinparam ControlBorderColor #AD1457
skinparam EntityBackgroundColor #FCE4EC
skinparam EntityBorderColor #AD1457
skinparam DatabaseBackgroundColor #FCE4EC
skinparam DatabaseBorderColor #AD1457
skinparam ActorBackgroundColor #FFD27F
skinparam ActorBorderColor #000000

title Biểu đồ tuần tự — Hỏi đáp Q&A

autonumber

actor    "Bệnh nhân"       as BN
actor    "Quản trị"        as QT
actor    "Bác sĩ"          as BS
boundary "Trình duyệt"     as B
control  "QnaController"   as C
entity   "QnaService"      as S
database "Bảng [Question]"    as TQ
database "Bảng [Answer]"      as TAN
database "Bảng [AuditSystem]" as TAU

BN -> B: Vào /hoi-dap → Đặt câu hỏi mới
B -> C: GET /hoi-dap/dat-cau-hoi

alt Chưa đăng nhập
    C --> B: Redirect /dang-nhap
else Đã đăng nhập
    C --> B: Render form\n(tiêu đề, nội dung, chuyên khoa)
    BN -> B: Nhập + submit
    B -> C: POST /hoi-dap/dat-cau-hoi
    C -> C: Validate CSRF + length cap\n(body ≤ 500)
    C -> S: SubmitQuestionAsync(userId, title, body, deptId)
    S -> TQ: INSERT (Status = Pending,\nCreatedAt = now)
    TQ --> S: QuestionId
    S --> C: QuestionId
    C --> B: Hiển thị "Đã gửi, chờ duyệt"
end

== Quản trị viên duyệt câu hỏi ==

QT -> B: Vào /AdminCP/Qna
B -> C: GET danh sách câu hỏi pending
C -> TQ: SELECT WHERE Status = Pending
TQ --> C: List
C --> B: Render bảng duyệt

QT -> B: Approve / Reject 1 câu hỏi
B -> C: POST /AdminCP/Qna/Approve hoặc Reject

alt Approve
    C -> S: ApproveQuestionAsync(questionId)
    S -> TQ: UPDATE Status = Visible
    S -> TAU: INSERT (Action = QNA_APPROVED)
else Reject
    C -> S: RejectQuestionAsync(questionId, reason)
    S -> TQ: UPDATE Status = Rejected,\nSoftDelete = 1
    S -> TAU: INSERT (Action = QNA_REJECTED)
end

== Bác sĩ trả lời ==

BS -> B: Vào /bac-si-portal/qna
B -> C: GET câu hỏi thuộc chuyên khoa,\nStatus = Visible
C -> TQ: SELECT WHERE DepartmentId = ?\nAND Status = Visible
TQ --> C: List
C --> B: Render bảng câu hỏi

BS -> B: Nhập câu trả lời + submit
B -> C: POST /bac-si-portal/qna/answer
C -> S: AnswerQuestionAsync(questionId, answerBody)
S -> TAN: INSERT (QuestionId, Body,\nDoctorId, AnsweredAt = now)
S -> TQ: UPDATE Approved = true
S -> TAU: INSERT (Action = QNA_ANSWERED)
S --> C: OK
C --> B: Hiển thị "Đã trả lời"

note over BN
    Câu hỏi + trả lời hiển thị
    công khai trên /hoi-dap
end note

@enduml
