@startuml usecase-bacsi
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam usecase {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    ArrowColor #E65100
    FontColor #000000
}
skinparam actor {
    BackgroundColor #FFD27F
    BorderColor #000000
    FontStyle bold
}

actor "Bác sĩ" as BS

rectangle "Hệ thống Website TTYT Kinh Môn" {
    usecase "UC-20 Xem BN hôm nay" as UC20
    usecase "UC-21 Tạo hồ sơ + chẩn đoán" as UC21
    usecase "UC-22 Kê đơn thuốc" as UC22
    usecase "UC-23 Hoàn tất khám" as UC23
    usecase "UC-24 Trả lời câu hỏi BN" as UC24

    usecase "Cấp số hồ sơ\n(NextRecordNo)" as UCI_RECNO #FFF8E1
    usecase "Ghi audit log" as UCI_AUDIT #FFF8E1
}

BS -- UC20
BS -- UC21
BS -- UC22
BS -- UC23
BS -- UC24

UC21 ..> UCI_RECNO : <<include>>
UC21 ..> UCI_AUDIT : <<include>>
UC22 ..> UC21 : <<include>>
UC23 ..> UC21 : <<include>>

@enduml
