@startuml activity-login
skinparam dpi 300
' =========================================================================
' Hình 2.8 — Biểu đồ hoạt động Đăng nhập
' Ghi rõ bảng CSDL bị tác động ở mỗi bước
' =========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF3E0
skinparam ActivityDiamondBorderColor #E65100
skinparam ArrowColor #1976D2
skinparam SwimlaneBorderColor #424242
skinparam SwimlaneTitleFontStyle bold
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F57F17

title Sơ đồ hoạt động: Đăng nhập hệ thống

|Người dùng|
start
:Truy cập /dang-nhap;
:Nhập tên đăng nhập và mật khẩu;
:Gửi yêu cầu đăng nhập;

|Hệ thống|
:Nhận POST /dang-nhap;

if (Anti-forgery token hợp lệ?) then (Không)
  :Trả về HTTP 400;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
:SELECT từ bảng **[User]**\nWHERE UserName = ?\nAND ActiveFlag = 1;

if (Tài khoản tồn tại?) then (Không)
  :Trả lỗi: thông tin sai;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
if (LockoutUntil > now?) then (Có)
  :Trả lỗi: tài khoản bị khóa\n(sai 5 lần liên tiếp);
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Không)
endif

|Hệ thống|
:Xác minh mật khẩu PBKDF2-SHA256\n(600.000 vòng);

if (Mật khẩu đúng?) then (Không)
  :UPDATE bảng **[User]**\nSET FailedAttempts += 1;
  if (FailedAttempts ≥ 5?) then (Có)
    :UPDATE bảng **[User]**\nSET LockoutUntil = now + 15',\nFailedAttempts = 0;
  else (Không)
  endif
  :Trả lỗi đăng nhập;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
:UPDATE bảng **[User]**\nSET FailedAttempts = 0,\nLockoutUntil = null,\nLastLogin = now;
:INSERT vào bảng **[AuditSystem]**\n(Action = Đăng nhập, IP, UA);

if (Mật khẩu mặc định "123456"?) then (Có)
  :Yêu cầu đổi mật khẩu;
  |Người dùng|
  :Vào /doi-mat-khau;
  stop
else (Không)
endif

|Hệ thống|
:Tạo session\n+ set cookie HttpOnly;

if (Vai trò Admin?) then (Có)
  :Redirect /AdminCP/Default;
else (Không)
  :Redirect / hoặc /ho-so\ntheo vai trò;
endif

|Người dùng|
:Truy cập giao diện theo vai trò;
stop
@enduml
