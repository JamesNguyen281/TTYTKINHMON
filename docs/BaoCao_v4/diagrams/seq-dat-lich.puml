@startuml seq-dat-lich
' =========================================================================
' Hình 2.13 — Biểu đồ tuần tự nghiệp vụ Đặt lịch khám
' =========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5
skinparam ParticipantBackgroundColor #F3E5F5
skinparam ParticipantBorderColor #7B1FA2
skinparam ActorBackgroundColor #FFD27F
skinparam ActorBorderColor #000000

title Biểu đồ tuần tự — Đặt lịch khám

autonumber

actor "Bệnh nhân" as BN
participant "Trình duyệt"          as B
participant "AppointmentController" as C
participant "AppointmentService"    as S
participant "QuotaService"          as Q
database    "SQL Server"            as DB

BN -> B: Vào /dat-lich-kham
B -> C: GET /dat-lich-kham
C -> DB: SELECT phòng khám\nKhoa Khám bệnh
DB --> C: List clinic_room
C --> B: Render form\n(chọn ngày, ca, triệu chứng)

BN -> B: Điền form + submit
B -> C: POST /dat-lich-kham
C -> C: Validate CSRF + dữ liệu vào

alt Dữ liệu không hợp lệ
    C --> B: Hiển thị lỗi validation
else Dữ liệu hợp lệ
    C -> S: CreateAppointmentAsync(symptoms, date, session)
    S -> S: Kiểm tra trùng buổi\n(cùng tài khoản + ngày + ca)
    alt Đã có lịch buổi này
        S --> C: Exception "Trùng buổi"
        C --> B: Hiển thị link "Lịch của tôi"
    else Chưa trùng
        S -> Q: CheckQuotaAsync(deptId, date, session)
        Q -> DB: SELECT quota_dept + quota_doctor
        DB --> Q: Quota records
        alt Hết suất
            Q --> S: QuotaExceeded
            S --> C: Exception "Hết suất khám"
            C --> B: Hiển thị thông báo\n+ gợi ý ngày khác
        else Còn suất
            Q --> S: OK
            S -> DB: INSERT appointment\n(status=Pending, dept=Khoa Khám)
            DB --> S: appointment_id
            S -> DB: INSERT audit_system\n(action=APPOINTMENT_CREATED)
            S --> C: appointment_id + temp_code
            C --> B: Redirect /xac-nhan-dat-lich\n(hiển thị mã tạm)
        end
    end
end

@enduml
