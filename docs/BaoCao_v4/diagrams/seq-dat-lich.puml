@startuml seq-dat-lich
' =========================================================================
' Hình 2.13 — Biểu đồ tuần tự nghiệp vụ Đặt lịch khám
' =========================================================================
skinparam dpi 300
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5
skinparam BoundaryBackgroundColor #F3E5F5
skinparam BoundaryBorderColor #7B1FA2
skinparam ControlBackgroundColor #F3E5F5
skinparam ControlBorderColor #7B1FA2
skinparam EntityBackgroundColor #F3E5F5
skinparam EntityBorderColor #7B1FA2
skinparam DatabaseBackgroundColor #F3E5F5
skinparam DatabaseBorderColor #7B1FA2
skinparam ActorBackgroundColor #FFD27F
skinparam ActorBorderColor #000000

title Biểu đồ tuần tự — Đặt lịch khám

autonumber

actor    "Bệnh nhân"              as BN
boundary "Trình duyệt"            as B
control  "AppointmentController"  as C
entity   "AppointmentService"     as S
database "Bảng [Department]"   as TD
database "Bảng [Appointment]"  as TA

BN -> B: Vào /dat-lich-kham
B -> C: GET /dat-lich-kham
C --> B: Render form\n(họ tên, SĐT, ngày, ca, triệu chứng)

BN -> B: Điền form + submit
B -> C: POST /dat-lich-kham
C -> C: Validate CSRF + dữ liệu vào

alt Dữ liệu không hợp lệ
    C --> B: Hiển thị lỗi validation
else Dữ liệu hợp lệ
    C -> S: BookAsync(input, patientUserId, siteId)
    S -> TD: SELECT WHERE Alias = 'khoa-kham-benh'\nAND SiteId = ? AND ActiveFlag = 1
    TD --> S: Khoa Khám bệnh
    alt Không có khoa
        S --> C: ErrorMessage "Hệ thống chưa khởi tạo Khoa Khám bệnh"
        C --> B: Hiển thị lỗi
    else Có khoa
        opt Bệnh nhân đã đăng nhập
            S -> TA: SELECT WHERE PatientUserId = ?\nAND Date = ? AND Session = ?\nAND Status IN (Pending, Confirmed)
            TA --> S: Trùng buổi (nếu có)
            alt Đã có lịch
                S --> C: ErrorMessage "Đã có lịch ở buổi này"
                C --> B: Hiển thị + link "Lịch của tôi"
            end
        end
        S -> S: Tạo Appointment\n(Status = Pending, ClinicRoomId = null,\nDepartmentId = khoaKham.Id)
        S -> TA: INSERT (...)
        TA --> S: AppointmentId
        S --> C: BookingResult.Success(apptId)
        C --> B: Redirect /xac-nhan-dat-lich
    end
end

@enduml
