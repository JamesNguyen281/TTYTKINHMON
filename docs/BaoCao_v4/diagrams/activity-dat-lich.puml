@startuml activity-dat-lich
skinparam dpi 300
' =========================================================================
' Hình 2.9 — Biểu đồ hoạt động Đặt lịch khám
' Ghi rõ bảng CSDL bị tác động ở mỗi bước
' =========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF3E0
skinparam ActivityDiamondBorderColor #E65100
skinparam ArrowColor #1976D2
skinparam SwimlaneBorderColor #424242
skinparam SwimlaneTitleFontStyle bold
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F57F17

title Sơ đồ hoạt động: Đặt lịch khám

|Bệnh nhân|
start
:Truy cập /dat-lich-kham;

|Hệ thống|
if (Đã đăng nhập?) then (Có)
  :Tự điền họ tên, SĐT, email\ntừ hồ sơ;
else (Không)
  :Hiển thị form trống\n+ gợi ý đăng nhập;
endif

|Bệnh nhân|
:Chọn ngày khám, ca khám;
:Nhập triệu chứng;
:Gửi yêu cầu đặt lịch;

|Hệ thống|
:Nhận POST /dat-lich-kham;

if (Anti-forgery token hợp lệ?) then (Không)
  :Trả về HTTP 400;
  |Bệnh nhân|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
if (Đủ họ tên + SĐT?) then (Không)
  :Trả lỗi: thiếu thông tin bắt buộc;
  |Bệnh nhân|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
if (Ngày khám trong\n[hôm nay, hôm nay + 14]?) then (Không)
  :Trả lỗi: ngày không hợp lệ;
  |Bệnh nhân|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
:SELECT từ bảng **[Department]**\nAlias = 'khoa-kham-benh';
note right: Tra Khoa Khám bệnh\nđể auto-gán DepartmentId

if (Bệnh nhân đã đăng nhập?) then (Có)
  :SELECT từ bảng **[Appointment]**\nUserId + Date + Session;
  note right: Kiểm tra trùng buổi
  if (Đã có lịch cùng buổi?) then (Có)
    :Trả lỗi: trùng buổi;
    |Bệnh nhân|
    :Xem thông báo + link Lịch của tôi;
    stop
  else (Không)
  endif
endif

|Hệ thống|
:INSERT vào bảng **[Appointment]**\n(Status = Pending,\nDepartmentId = Khoa Khám,\nClinicRoomId = null);

|Bệnh nhân|
:Vào /xac-nhan-dat-lich\nxem mã đặt lịch tạm;
stop
@enduml
