@startuml activity-checkin
skinparam dpi 300
' =========================================================================
' Hình 2.10 — Biểu đồ hoạt động Check-in bệnh nhân
' Ghi rõ bảng CSDL bị tác động ở mỗi bước
' =========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF3E0
skinparam ActivityDiamondBorderColor #E65100
skinparam ArrowColor #1976D2
skinparam SwimlaneBorderColor #424242
skinparam SwimlaneTitleFontStyle bold
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F57F17

title Sơ đồ hoạt động: Check-in bệnh nhân

|Bệnh nhân|
start
:Tới quầy lễ tân;
:Xuất trình mã booking\n(KMyymmddSxxxxx);

|Lễ tân|
:Nhập mã vào /le-tan/check-in;
:Submit POST /le-tan/check-in;

|Hệ thống|
:SELECT từ bảng **[Appointment]**\nWHERE BookingCode = ?;
note right: Tra cứu lịch theo mã

if (Tìm thấy lịch?) then (Không)
  :Trả lỗi: mã không tồn tại;
  |Lễ tân|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
if (Status = Confirmed?) then (Không)
  :Trả lỗi: lịch chưa được duyệt;
  |Lễ tân|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
if (AppointmentDate = today?) then (Không)
  :Trả lỗi: không đúng ngày khám;
  |Lễ tân|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Hệ thống|
if (Đã CheckedIn = true?) then (Có)
  :Idempotent — trả OK\nkhông UPDATE lại;
else (Không)
  :UPDATE bảng **[Appointment]**\nSET CheckedIn = true,\nLuUpdated = now,\nLuUserId = staff;
  :INSERT vào bảng **[AuditSystem]**\n(Action = Check-in bệnh nhân);
endif

|Lễ tân|
:Hướng dẫn BN tới phòng khám;

|Bệnh nhân|
:Chờ gọi tên vào phòng khám;
stop
@enduml
