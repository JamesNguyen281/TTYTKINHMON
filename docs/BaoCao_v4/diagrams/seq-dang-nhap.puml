@startuml seq-dang-nhap
' =========================================================================
' Hình 2.12 — Biểu đồ tuần tự nghiệp vụ Đăng nhập
' =========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5
skinparam ParticipantBackgroundColor #E3F2FD
skinparam ParticipantBorderColor #1976D2
skinparam ActorBackgroundColor #FFD27F
skinparam ActorBorderColor #000000

title Biểu đồ tuần tự — Đăng nhập

autonumber

actor "Người dùng" as U
participant "Trình duyệt" as B
participant "AuthController" as C
participant "UserService"   as S
database "SQL Server"        as DB

U -> B: Truy cập /dang-nhap
B -> C: GET /dang-nhap
C --> B: Render form\n(anti-CSRF token)

U -> B: Nhập username + password
B -> C: POST /dang-nhap\n(token + form)
C -> C: Validate CSRF token

alt CSRF không hợp lệ
    C --> B: HTTP 400 Bad Request
else CSRF hợp lệ
    C -> S: ValidateCredentialsAsync(user, pass)
    S -> DB: SELECT user WHERE username=?
    DB --> S: User record\n(password_hash, salt, failed_count)
    S -> S: Verify PBKDF2-SHA256\n(600.000 vòng)
    alt Mật khẩu sai
        S -> DB: UPDATE failed_count + 1
        DB --> S: OK
        alt failed_count ≥ 5
            S -> DB: UPDATE locked_until = now + 15 phút
        end
        S --> C: AuthResult.Failure
        C --> B: Hiển thị "Sai tài khoản/mật khẩu"
    else Mật khẩu đúng
        S -> DB: UPDATE failed_count = 0, last_login = now
        DB --> S: OK
        S --> C: AuthResult.Success(user, role)
        C -> C: Tạo session cookie\n(HttpOnly, Secure)
        alt must_change_password = 1
            C --> B: Redirect /doi-mat-khau
        else
            C --> B: Redirect / hoặc /AdminCP/Default\ntheo vai trò
        end
    end
end

@enduml
