@startuml seq-duyet-lich
' =========================================================================
' Hình 2.14 — Biểu đồ tuần tự nghiệp vụ Duyệt lịch 
' =========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5
skinparam ParticipantBackgroundColor #E8F5E9
skinparam ParticipantBorderColor #2E7D32
skinparam ActorBackgroundColor #FFD27F
skinparam ActorBorderColor #000000

title Biểu đồ tuần tự — Duyệt và xác nhận lịch hẹn

autonumber

actor "Lễ tân" as LT
participant "Trình duyệt"               as B
participant "LeTanController"           as C
participant "AppointmentService"        as AS
participant "DoctorScheduleService"     as DS
database    "SQL Server"                as DB

LT -> B: Vào /le-tan/lich-hen
B -> C: GET /le-tan/lich-hen
C -> DB: SELECT appointment WHERE status=Pending
DB --> C: List lịch chờ duyệt
C --> B: Render danh sách

LT -> B: Click chi tiết 1 lịch
B -> C: GET /le-tan/detail/{id}
C -> DB: SELECT appointment + customer
DB --> C: Appointment detail
C --> B: Render form\n(chọn phòng khám + BS)

LT -> B: Chọn phòng khám chuyên môn
B -> C: AJAX /available-doctors?roomId=X
C -> DS: GetAvailableDoctors(roomId, date, session)
DS -> DB: SELECT doctor_schedule\nWHERE room=? AND date=?
DB --> DS: List BS đang trực

alt Không có BS nào trực phòng X
    DS --> C: Empty list
    C -> DS: GetAvailableDoctors(deptId, date, session) — fallback
    DS -> DB: SELECT all BS thuộc khoa
    DB --> DS: List BS toàn khoa
    DS --> C: List BS (fallback)
    C --> B: Banner vàng\n"phòng chưa có BS" + list toàn khoa
else Có BS trực
    DS --> C: List BS chuyên phòng
    C --> B: Banner xanh\n"đang lọc theo phòng" + list BS phòng
end

LT -> B: Chọn BS + nhấn Xác nhận
B -> C: POST /le-tan/duyet
C -> AS: ConfirmAppointmentAsync(apptId, roomId,\ndoctorId, staffNote)
AS -> AS: Kiểm tra state machine\nPending → Confirmed
AS -> AS: Generate booking_code\nKMyymmdd-XXXXXX
AS -> DB: UPDATE appointment SET\nstatus=Confirmed, booking_code, room, doctor
AS -> DB: UPDATE quota +1\ncho khoa và BS
AS -> DB: INSERT audit_system\n(action=APPOINTMENT_CONFIRMED)
AS --> C: booking_code
C --> B: Hiển thị mã booking thành công

@enduml
