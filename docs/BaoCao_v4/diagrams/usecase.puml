@startuml usecase
skinparam dpi 300
' =========================================================================
' Hình 2.1 — Biểu đồ Use Case TỔNG QUÁT
' Bố cục: 3 phân hệ (BS, AD, LT) ở cột giữa-trái với actor bên trái,
'         BN actor bên phải với phân hệ BN ở giữa-phải.
' =========================================================================
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    ArrowColor      #000000
    FontColor       #000000
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor     #000000
    FontStyle       bold
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor     #000000
}

actor "BÁC SĨ"    as BS
actor "ADMIN"     as AD
actor "LỄ TÂN"    as LT
actor "BỆNH NHÂN" as BN

rectangle "**HỆ THỐNG WEBSITE TTYT PHƯỜNG KINH MÔN**" {

  rectangle "Phân hệ bác sĩ" as PBS {
    usecase "Xem bệnh nhân hôm nay"    as UCBS3
    usecase "Tạo hồ sơ + chẩn đoán"    as UCBS2
    usecase "Kê đơn thuốc"             as UCBS4
    usecase "Trả lời Q&A"              as UCBS5
  }

  rectangle "Phân hệ admin" as PAD {
    usecase "Cấu hình website"   as UCAD1
    usecase "Quản lý user"       as UCAD2
    usecase "Quản lý tài liệu"   as UCAD3
    usecase "Xem audit log"      as UCAD4
    usecase "Force change pwd"   as UCAD5
  }

  rectangle "Phân hệ lễ tân" as PLT {
    usecase "Check-in bệnh nhân"        as UCLT1
    usecase "Quản lý quota khám"        as UCLT2
    usecase "Xem lịch trực bác sĩ"      as UCLT3
    usecase "Phân phòng khám + bác sĩ"  as UCLT4
    usecase "Xem danh sách lịch hẹn"    as UCLT5
    usecase "Quản lý yêu cầu đặt lịch"  as UCLT6
  }

  rectangle "Phân hệ bệnh nhân" as PBN {
    usecase "Đăng nhập / đăng ký tài khoản" as UCBN1
    usecase "Đặt lịch khám"                  as UCBN2
    usecase "Đặt câu hỏi Q&A"                as UCBN3
    usecase "Xem lịch của tôi"               as UCBN4
    usecase "Xem lịch sử khám"               as UCBN5
    usecase "Quản lý hồ sơ cá nhân"          as UCBN6
  }
}

' Actor → UC
BS -- UCBS3
BS -- UCBS2
BS -- UCBS4
BS -- UCBS5

AD -- UCAD1
AD -- UCAD2
AD -- UCAD3
AD -- UCAD4
AD -- UCAD5

LT -- UCLT1
LT -- UCLT2
LT -- UCLT3
LT -- UCLT4
LT -- UCLT5
LT -- UCLT6

UCBN1 -- BN
UCBN2 -- BN
UCBN3 -- BN
UCBN4 -- BN
UCBN5 -- BN
UCBN6 -- BN

' Hidden: 3 actor stacked vertically on left
BS -[hidden]down- AD
AD -[hidden]down- LT

@enduml
